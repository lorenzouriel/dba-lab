# cp .env.example .env  &&  edit
# Password policy: 8+ chars, 3 of 4 sets (upper, lower, digit, symbol).
# The container silently fails to start if it doesn't comply — check `docker compose logs prod1`.
MSSQL_SA_PASSWORD=Ch4nge_This_N0w!

# Ports on the host
# PROD1_PORT: AG primary
PROD1_PORT=1401
# PROD2_PORT: AG secondary, synchronous-commit HA — ha profile
PROD2_PORT=1402
# PROD3_PORT: AG secondary, asynchronous-commit read-scale-only — ha profile
PROD3_PORT=1405
# DEV_PORT: dev profile
DEV_PORT=1403
# STAGING_PORT: staging profile
STAGING_PORT=1404

# Memory. MSSQL_MEMORY_LIMIT_MB is SQL Server's own cap ('max server memory');
# *_MEM_LIMIT is the cgroup cap on the container. Keep the cgroup ~25% higher
# so CLR, backup buffers, and the SQLOS thread stacks have headroom.
PROD1_MEMORY_LIMIT_MB=6144
PROD1_MEM_LIMIT=8g
PROD2_MEMORY_LIMIT_MB=4096
PROD2_MEM_LIMIT=6g
PROD3_MEMORY_LIMIT_MB=4096
PROD3_MEM_LIMIT=6g
DEV_MEMORY_LIMIT_MB=4096
DEV_MEM_LIMIT=6g
STAGING_MEMORY_LIMIT_MB=4096
STAGING_MEM_LIMIT=6g

# Keep LCID/messages at the 1033 default so errors match the English docs.
MSSQL_COLLATION=SQL_Latin1_General_CP1_CI_AS
TZ=America/Sao_Paulo

# Used by the `seed` profile. SEED_TARGET picks which instance gets restored
# into (defaults to prod1) — set to dev or staging to seed those instead.
SEED_TARGET=prod1
SEED_DB=AdventureWorksDW2025
SEED_BAK=AdventureWorksDW2025.bak

# Always Encrypted lab CMK (PFX) password and TDE certificate backup password
AE_CMK_PFX_PASSWORD=Ch4nge_This_T00!
TDE_KEY_PASSWORD=Ch4nge_This_T00!
